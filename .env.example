# Copy to .env and fill in. Never commit .env.
# MODEL uses LangChain's "provider:model" format, e.g.
#   google_genai:gemini-3.5-flash   (needs GOOGLE_API_KEY; used to generate examples/)
#   anthropic:claude-sonnet-5-5     (needs ANTHROPIC_API_KEY)
MODEL=

# Optional, Claude only: reasoning effort (low|medium|high)
MODEL_EFFORT=

# Provider credentials (set only the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Optional: freeze the clock for scripted runs (ISO 8601, America/Campo_Grande if no offset)
NOW=
